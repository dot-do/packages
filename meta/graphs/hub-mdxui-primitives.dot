  "@mdxui/payload" [label="mdxui/\npayload", fillcolor="white"];
  "@mdxui/soc2" [label="mdxui/\nsoc2", fillcolor="white"];
  "@mdxui/issues" [label="mdxui/\nissues", fillcolor="white"];
