digraph dependencies {
  label="@mdxui internal dependencies";
  labelloc="t";
  rankdir=LR;
  node [shape=box, style=filled, fillcolor=white];
  edge [color="#666666"];
  "@mdxui/primitives" [label="mdxui/\nprimitives", fillcolor="white"];
  "@mdxui/beacon" [label="mdxui/\nbeacon", fillcolor="white"];
  "@mdxui/themes" [label="mdxui/\nthemes", fillcolor="white"];
  "@mdxui/cockpit" [label="mdxui/\ncockpit", fillcolor="white"];
  "@mdxui/do" [label="mdxui/\ndo", fillcolor="white"];
  "@mdxui/admin" [label="mdxui/\nadmin", fillcolor="white"];
  "@mdxui/widgets" [label="mdxui/\nwidgets", fillcolor="white"];
  "@mdxui/app" [label="mdxui/\napp", fillcolor="white"];
  "@mdxui/terminal" [label="mdxui/\nterminal", fillcolor="white"];
  "@mdxui/zero" [label="mdxui/\nzero", fillcolor="white"];
  "@mdxui/dochat" [label="mdxui/\ndochat", fillcolor="white"];
  "@mdxui/auth" [label="mdxui/\nauth", fillcolor="white"];
  "@mdxui/payload" [label="mdxui/\npayload", fillcolor="white"];
  "@mdxui/soc2" [label="mdxui/\nsoc2", fillcolor="white"];
  "@mdxui/navigation" [label="mdxui/\nnavigation", fillcolor="white"];
  "@mdxui/dashboard-panels" [label="mdxui/\ndashboard-panels", fillcolor="white"];
  "@mdxui/named" [label="mdxui/\nnamed", fillcolor="white"];
  "@mdxui/tremor" [label="mdxui/\ntremor", fillcolor="white"];
  "@mdxui/discovery" [label="mdxui/\ndiscovery", fillcolor="white"];
  "@mdxui/api" [label="mdxui/\napi", fillcolor="white"];
  "@mdxui/issues" [label="mdxui/\nissues", fillcolor="white"];
  "@mdxui/directory" [label="mdxui/\ndirectory", fillcolor="white"];
  "@mdxui/fumadocs" [label="mdxui/\nfumadocs", fillcolor="white"];
  "@mdxui/shared" [label="mdxui/\nshared", fillcolor="white"];
  "@mdxui/types" [label="mdxui/\ntypes", fillcolor="white"];
  "@mdxui/marketing" [label="mdxui/\nmarketing", fillcolor="white"];
  "@mdxui/dashboard" [label="mdxui/\ndashboard", fillcolor="white"];
  "@mdxui/blog" [label="mdxui/\nblog", fillcolor="white"];
  "@mdxui/docs" [label="mdxui/\ndocs", fillcolor="white"];
  "@mdxui/cockpit" -> "@mdxui/auth";
  "@mdxui/do" -> "@mdxui/admin";
  "@mdxui/do" -> "@mdxui/app";
  "@mdxui/do" -> "@mdxui/navigation";
  "@mdxui/do" -> "@mdxui/primitives";
  "@mdxui/do" -> "@mdxui/auth";
  "@mdxui/admin" -> "@mdxui/primitives";
  "@mdxui/widgets" -> "@mdxui/primitives";
  "@mdxui/app" -> "@mdxui/primitives";
  "@mdxui/zero" -> "@mdxui/primitives";
  "@mdxui/auth" -> "@mdxui/primitives";
  "@mdxui/payload" -> "@mdxui/auth";
  "@mdxui/payload" -> "@mdxui/beacon";
  "@mdxui/payload" -> "@mdxui/cockpit";
  "@mdxui/payload" -> "@mdxui/primitives";
  "@mdxui/soc2" -> "@mdxui/primitives";
  "@mdxui/issues" -> "@mdxui/primitives";
  "@mdxui/directory" -> "@mdxui/primitives";
  "@mdxui/marketing" -> "@mdxui/types";
  "@mdxui/marketing" -> "@mdxui/shared";
  "@mdxui/marketing" -> "@mdxui/widgets";
  "@mdxui/dashboard" -> "@mdxui/shared";
  "@mdxui/dashboard" -> "@mdxui/widgets";
  "@mdxui/blog" -> "@mdxui/shared";
  "@mdxui/docs" -> "@mdxui/types";
  "@mdxui/docs" -> "@mdxui/shared";
  "@mdxui/docs" -> "@mdxui/widgets";
}
