digraph dependencies {
  label="@icetype internal dependencies";
  labelloc="t";
  rankdir=LR;
  node [shape=box, style=filled, fillcolor=white];
  edge [color="#666666"];
  "@icetype/core" [label="icetype/\ncore", fillcolor="white"];
  "@icetype/sql-common" [label="icetype/\nsql-common", fillcolor="white"];
  "@icetype/migrations" [label="icetype/\nmigrations", fillcolor="white"];
  "@icetype/sqlite" [label="icetype/\nsqlite", fillcolor="white"];
  "@icetype/drizzle" [label="icetype/\ndrizzle", fillcolor="white"];
  "@icetype/iceberg" [label="icetype/\niceberg", fillcolor="white"];
  "@icetype/prisma" [label="icetype/\nprisma", fillcolor="white"];
  "@icetype/postgres" [label="icetype/\npostgres", fillcolor="white"];
  "@icetype/mysql" [label="icetype/\nmysql", fillcolor="white"];
  "@icetype/clickhouse" [label="icetype/\nclickhouse", fillcolor="white"];
  "@icetype/duckdb" [label="icetype/\nduckdb", fillcolor="white"];
  "@icetype/adapters" [label="icetype/\nadapters", fillcolor="white"];
  "@icetype/cli" [label="icetype/\ncli", fillcolor="white"];
  "@icetype/playground-core" [label="icetype/\nplayground-core", fillcolor="white"];
  "@icetype/test-utils" [label="icetype/\ntest-utils", fillcolor="white"];
  "@icetype/migrations" -> "@icetype/core";
  "@icetype/sqlite" -> "@icetype/core";
  "@icetype/sqlite" -> "@icetype/sql-common";
  "@icetype/drizzle" -> "@icetype/core";
  "@icetype/iceberg" -> "@icetype/core";
  "@icetype/prisma" -> "@icetype/core";
  "@icetype/postgres" -> "@icetype/core";
  "@icetype/postgres" -> "@icetype/migrations";
  "@icetype/postgres" -> "@icetype/sql-common";
  "@icetype/mysql" -> "@icetype/core";
  "@icetype/mysql" -> "@icetype/migrations";
  "@icetype/mysql" -> "@icetype/sql-common";
  "@icetype/clickhouse" -> "@icetype/core";
  "@icetype/clickhouse" -> "@icetype/sql-common";
  "@icetype/duckdb" -> "@icetype/core";
  "@icetype/duckdb" -> "@icetype/sql-common";
  "@icetype/adapters" -> "@icetype/core";
  "@icetype/cli" -> "@icetype/adapters";
  "@icetype/cli" -> "@icetype/clickhouse";
  "@icetype/cli" -> "@icetype/core";
  "@icetype/cli" -> "@icetype/drizzle";
  "@icetype/cli" -> "@icetype/duckdb";
  "@icetype/cli" -> "@icetype/iceberg";
  "@icetype/cli" -> "@icetype/mysql";
  "@icetype/cli" -> "@icetype/postgres";
  "@icetype/cli" -> "@icetype/prisma";
  "@icetype/cli" -> "@icetype/sqlite";
  "@icetype/playground-core" -> "@icetype/core";
  "@icetype/playground-core" -> "@icetype/postgres";
  "@icetype/playground-core" -> "@icetype/mysql";
  "@icetype/playground-core" -> "@icetype/sqlite";
  "@icetype/test-utils" -> "@icetype/core";
}
